# Salin file ini menjadi .env lalu isi nilainya.
# Supabase Dashboard -> Connect -> Type: JDBC, Method: Session pooler
# Salin URL-nya TANPA bagian ?user=...&password=...
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<database-password>

# Secret untuk menandatangani JWT, minimal 32 karakter acak. Contoh membuatnya: openssl rand -base64 48
JWT_SECRET=<random-secret-min-32-chars>
